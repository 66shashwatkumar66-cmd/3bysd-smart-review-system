rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email != null &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return request.auth.token.email.trim().lower();
    }

    function hasMasterReauthorizedEmail() {
      return hasVerifiedEmail() &&
        exists(/databases/$(database)/documents/admins/$(authEmailLower()));
    }

    function isNotRevoked() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accessRevoked', false) != true ||
        (
          hasMasterReauthorizedEmail() && (
            !('revokedAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
            !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.revokedAt is string) ||
            get(/databases/$(database)/documents/admins/$(authEmailLower())).data.get('updatedAt', '') >
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.revokedAt
          )
        );
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        (hasVerifiedEmail() && authEmailLower() == '66shashwatkumar66@gmail.com') ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'master') ||
        (hasVerifiedEmail() &&
         exists(/databases/$(database)/documents/admins/$(authEmailLower())) &&
         get(/databases/$(database)/documents/admins/$(authEmailLower())).data.get('role', '') == 'master')
      );
    }

    function adminAllowsCardEdit(adminDoc) {
      return adminDoc != null && (
        !('permissions' in adminDoc.data) ||
        !(adminDoc.data.permissions is map) ||
        adminDoc.data.permissions.get('canEditCards', true) != false
      );
    }

    function adminAllowsAiToggleForDoc(adminDoc) {
      return adminDoc != null && (
        !('permissions' in adminDoc.data) ||
        !(adminDoc.data.permissions is map) ||
        adminDoc.data.permissions.get('canToggleAi', true) != false
      );
    }

    function adminCanEditFlagNotDisabled() {
      return (
        !exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        adminAllowsCardEdit(get(/databases/$(database)/documents/admins/$(request.auth.uid)))
      ) && (
        !hasVerifiedEmail() ||
        !exists(/databases/$(database)/documents/admins/$(authEmailLower())) ||
        adminAllowsCardEdit(get(/databases/$(database)/documents/admins/$(authEmailLower())))
      );
    }

    function adminAllowsAiToggle() {
      return !incoming().diff(existing()).affectedKeys().hasAny(['aiReviewEnabled']) ||
        incoming().get('aiReviewEnabled', true) == existing().get('aiReviewEnabled', true) || (
          (
            !exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
            adminAllowsAiToggleForDoc(get(/databases/$(database)/documents/admins/$(request.auth.uid)))
          ) && (
            !hasVerifiedEmail() ||
            !exists(/databases/$(database)/documents/admins/$(authEmailLower())) ||
            adminAllowsAiToggleForDoc(get(/databases/$(database)/documents/admins/$(authEmailLower())))
          )
        );
    }

    function cardIdInList(cardId, list) {
      return list is list && (
        cardId in list ||
        ('#' + cardId) in list ||
        cardId.lower() in list ||
        ('#' + cardId.lower()) in list ||
        cardId.upper() in list ||
        ('#' + cardId.upper()) in list ||
        (cardId.matches('^0+[0-9]+$') && (
          cardId.replace('^0+', '') in list ||
          ('#' + cardId.replace('^0+', '')) in list
        ))
      );
    }

    function isSubAdminAssignedCard(cardId) {
      return isAuthenticated() && isNotRevoked() && (
        isMasterAdmin() ||
        // 1. Admin record lookup by UID
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         cardIdInList(cardId, get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('assignedCardIds', []))) ||
        // 2. Admin record lookup by verified lowercase email
        (hasVerifiedEmail() &&
         exists(/databases/$(database)/documents/admins/$(authEmailLower())) &&
         cardIdInList(cardId, get(/databases/$(database)/documents/admins/$(authEmailLower())).data.get('assignedCardIds', []))) ||
        // 3. Direct assignment on card by verified email
        (resource != null &&
         hasVerifiedEmail() &&
         'assignedToEmail' in resource.data &&
         resource.data.assignedToEmail is string &&
         resource.data.assignedToEmail.trim().lower() == authEmailLower()) ||
        // 4. Direct assignment on card by UID or canonical admin ID
        (resource != null &&
         'assignedToUid' in resource.data &&
         resource.data.assignedToUid is string &&
         (
           resource.data.assignedToUid == request.auth.uid ||
           (hasVerifiedEmail() &&
            exists(/databases/$(database)/documents/admins/$(authEmailLower())) &&
            resource.data.assignedToUid == get(/databases/$(database)/documents/admins/$(authEmailLower())).data.get('id', ''))
         )) ||
        // 5. Authorized Sub-Admin user profile lookup by UID
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') == 'restricted' &&
         cardIdInList(cardId, get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('assignedCardIds', [])))
      );
    }

    function isSubAdminForCard(cardId) {
      return isSubAdminAssignedCard(cardId) && (isMasterAdmin() || adminCanEditFlagNotDisabled());
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCard(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 64 &&
        data.status is string &&
        (data.status == 'available' || data.status == 'assigned' || data.status == 'disabled') &&
        (!('businessName' in data) || data.businessName == null || (data.businessName is string && data.businessName.size() <= 200)) &&
        (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 100)) &&
        (!('googleReviewUrl' in data) || data.googleReviewUrl == null || (data.googleReviewUrl is string && data.googleReviewUrl.size() <= 1000)) &&
        (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 500)) &&
        (!('aiReviewEnabled' in data) || data.aiReviewEnabled == null || data.aiReviewEnabled is bool) &&
        (!('assignedToEmail' in data) || data.assignedToEmail == null || (data.assignedToEmail is string && data.assignedToEmail.size() <= 200)) &&
        (!('assignedToUid' in data) || data.assignedToUid == null || (data.assignedToUid is string && data.assignedToUid.size() <= 128)) &&
        (!('assignedToName' in data) || data.assignedToName == null || (data.assignedToName is string && data.assignedToName.size() <= 200)) &&
        (!('scansCount' in data) || data.scansCount == null || ((data.scansCount is int || data.scansCount is float) && data.scansCount >= 0)) &&
        (!('customKeywords' in data) || data.customKeywords == null || (data.customKeywords is list && data.customKeywords.size() <= 100)) &&
        (!('reviewTone' in data) || data.reviewTone == null || (data.reviewTone is string && data.reviewTone.size() <= 50)) &&
        (!('promptStarter' in data) || data.promptStarter == null || (data.promptStarter is string && data.promptStarter.size() <= 1000)) &&
        (!('customHeadline' in data) || data.customHeadline == null || (data.customHeadline is string && data.customHeadline.size() <= 200)) &&
        (!('logoUrl' in data) || data.logoUrl == null || (data.logoUrl is string && data.logoUrl.size() <= 2000000)) &&
        (!('businessDescription' in data) || data.businessDescription == null || (data.businessDescription is string && data.businessDescription.size() <= 2000)) &&
        (!('whatsapp' in data) || data.whatsapp == null || (data.whatsapp is string && data.whatsapp.size() <= 500)) &&
        (!('instagram' in data) || data.instagram == null || (data.instagram is string && data.instagram.size() <= 500)) &&
        (!('subscriptionStartDate' in data) || data.subscriptionStartDate == null || (data.subscriptionStartDate is string && data.subscriptionStartDate.size() <= 64)) &&
        (!('subscriptionEndDate' in data) || data.subscriptionEndDate == null || (data.subscriptionEndDate is string && data.subscriptionEndDate.size() <= 64)) &&
        (!('subscriptionStatus' in data) || data.subscriptionStatus == null || (data.subscriptionStatus is string && data.subscriptionStatus.size() <= 32)) &&
        (!('reviewPageSettings' in data) || data.reviewPageSettings == null || data.reviewPageSettings is map);
    }

    function isValidAdmin(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.email is string &&
        data.email.size() > 0 &&
        data.email.size() <= 256 &&
        data.role is string &&
        (data.role == 'master' || data.role == 'restricted') &&
        (!('name' in data) || (data.name is string && data.name.size() <= 200)) &&
        (!('assignedCardIds' in data) || (data.assignedCardIds is list && data.assignedCardIds.size() <= 500)) &&
        (!('permissions' in data) || data.permissions is map) &&
        (!('aliasOf' in data) || data.aliasOf == null || (data.aliasOf is string && data.aliasOf.size() <= 128));
    }

    function isValidUser(data) {
      return data.uid is string &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128 &&
        data.email is string &&
        data.email.size() > 0 &&
        data.email.size() <= 256 &&
        (!('role' in data) || (data.role is string && (data.role == 'master' || data.role == 'restricted' || data.role == 'member'))) &&
        (!('accessRevoked' in data) || data.accessRevoked is bool) &&
        (!('requestStatus' in data) || data.requestStatus == null || (data.requestStatus is string && (data.requestStatus == 'pending' || data.requestStatus == 'approved' || data.requestStatus == 'rejected'))) &&
        (!('requestedAt' in data) || data.requestedAt == null || (data.requestedAt is string && data.requestedAt.size() <= 64)) &&
        (!('requestUpdatedAt' in data) || data.requestUpdatedAt == null || (data.requestUpdatedAt is string && data.requestUpdatedAt.size() <= 64)) &&
        (!('requestReviewedBy' in data) || data.requestReviewedBy == null || (data.requestReviewedBy is string && data.requestReviewedBy.size() <= 256)) &&
        (!('requestNote' in data) || data.requestNote == null || (data.requestNote is string && data.requestNote.size() <= 300));
    }

    function isValidAd(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 200 &&
        data.advertiser is string &&
        data.advertiser.size() > 0 &&
        data.advertiser.size() <= 200 &&
        data.headline is string &&
        data.headline.size() > 0 &&
        data.headline.size() <= 250 &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 1000)) &&
        (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2000000)) &&
        data.targetUrl is string &&
        data.targetUrl.size() > 0 &&
        data.targetUrl.size() <= 1500 &&
        (!('ctaText' in data) || data.ctaText == null || (data.ctaText is string && data.ctaText.size() <= 100)) &&
        data.placement is string &&
        (data.placement == 'below_biz_info' || data.placement == 'between_sections' || data.placement == 'below_draft' || data.placement == 'footer' || data.placement == 'disabled') &&
        data.status is string &&
        (data.status == 'active' || data.status == 'paused') &&
        (!('startDate' in data) || data.startDate == null || (data.startDate is string && data.startDate.size() <= 50)) &&
        (!('endDate' in data) || data.endDate == null || (data.endDate is string && data.endDate.size() <= 50)) &&
        (!('priority' in data) || data.priority == null || ((data.priority is int || data.priority is float) && data.priority >= 0)) &&
        (!('impressions' in data) || data.impressions == null || ((data.impressions is int || data.impressions is float) && data.impressions >= 0)) &&
        (!('clicks' in data) || data.clicks == null || ((data.clicks is int || data.clicks is float) && data.clicks >= 0));
    }

    function isValidScanLog(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.cardId is string &&
        data.cardId.size() > 0 &&
        data.cardId.size() <= 64 &&
        (!('businessName' in data) || data.businessName == null || (data.businessName is string && data.businessName.size() <= 200)) &&
        (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 100)) &&
        (!('timestamp' in data) || data.timestamp == null || (data.timestamp is string && data.timestamp.size() <= 64)) &&
        (!('scannedAt' in data) || data.scannedAt == null || (data.scannedAt is string && data.scannedAt.size() <= 64)) &&
        (!('device' in data) || data.device == null || (data.device is string && data.device.size() <= 100)) &&
        (!('browser' in data) || data.browser == null || (data.browser is string && data.browser.size() <= 100)) &&
        (!('ip' in data) || data.ip == null || (data.ip is string && data.ip.size() <= 64)) &&
        (!('referrer' in data) || data.referrer == null || (data.referrer is string && data.referrer.size() <= 500)) &&
        (!('source' in data) || data.source == null || (data.source is string && (data.source == 'qr' || data.source == 'nfc' || data.source == 'direct' || data.source == 'simulator'))) &&
        (!('subscriptionStatusAtScan' in data) || data.subscriptionStatusAtScan == null || (data.subscriptionStatusAtScan is string && data.subscriptionStatusAtScan.size() <= 32));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity test document used by boot diagnostics
    match /test/{docId} {
      allow get: if true;
      allow write: if false;
    }

    // Dynamic QR Cards Collection
    match /cards/{cardId} {
      // Public customer access to single card for QR/NFC review experience
      allow get: if true;

      // Scoped inventory listing: Master Admin sees all; authenticated users may only query their explicitly assigned cards
      allow list: if isMasterAdmin() || (
        isAuthenticated() && isNotRevoked() && (
          (hasVerifiedEmail() && resource.data.assignedToEmail == request.auth.token.email) ||
          (hasVerifiedEmail() && resource.data.assignedToEmail == authEmailLower()) ||
          resource.data.assignedToUid == request.auth.uid
        )
      );

      // Card Creation & Deletion strictly restricted to Master Admin
      allow create: if isValidId(cardId) && isMasterAdmin() && isValidCard(incoming());
      allow delete: if isValidId(cardId) && isMasterAdmin();

      // Card Updating restricted to Master Admin, authorized Sub-Admin (permitted fields only), or scan counter
      allow update: if isValidId(cardId) && isValidCard(incoming()) && (
        isMasterAdmin() ||
        (
          isSubAdminForCard(cardId) &&
          adminAllowsAiToggle() &&
          (incoming().status == existing().status || incoming().status == 'assigned' || incoming().status == 'disabled') &&
          !incoming().diff(existing()).affectedKeys().hasAny([
            'id',
            'assignedToEmail',
            'assignedToUid',
            'assignedToName',
            'scansCount',
            'createdAt'
          ]) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'status',
            'businessName',
            'category',
            'googleReviewUrl',
            'notes',
            'aiReviewEnabled',
            'customKeywords',
            'reviewTone',
            'promptStarter',
            'customHeadline',
            'logoUrl',
            'businessDescription',
            'whatsapp',
            'instagram',
            'subscriptionStartDate',
            'subscriptionEndDate',
            'subscriptionStatus',
            'reviewPageSettings',
            'updatedAt'
          ])
        ) ||
        // Public scan increment: only scansCount and updatedAt modified
        (incoming().diff(existing()).affectedKeys().hasOnly(['scansCount', 'updatedAt']))
      );
    }

    // Master and Restricted Admins Collection
    match /admins/{adminId} {
      allow get: if isAuthenticated() && (
        isMasterAdmin() ||
        request.auth.uid == adminId ||
        (hasVerifiedEmail() && (
          authEmailLower() == adminId.lower() ||
          (resource != null && resource.data.email is string && resource.data.email.lower() == authEmailLower())
        ))
      );
      allow list: if isMasterAdmin() || (isAuthenticated() && hasVerifiedEmail() && resource.data.email == authEmailLower());
      allow create, update: if isValidId(adminId) && isMasterAdmin() && isValidAdmin(incoming());
      allow delete: if isValidId(adminId) && isMasterAdmin() &&
        !(resource != null && 'email' in resource.data && resource.data.email is string && resource.data.email.lower() == '66shashwatkumar66@gmail.com');
    }

    // Google Verified Users Collection (Strictly protected user privacy)
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        isMasterAdmin() ||
        (hasVerifiedEmail() && resource != null && resource.data.email is string && resource.data.email.lower() == authEmailLower())
      );
      allow list: if isMasterAdmin() || (isAuthenticated() && hasVerifiedEmail() && resource.data.email == authEmailLower());
      allow create: if isValidId(userId) && isAuthenticated() && isValidUser(incoming()) && (
        isMasterAdmin() ||
        (
          request.auth.uid == userId &&
          incoming().get('accessRevoked', false) == false &&
          !('requestReviewedBy' in incoming()) &&
          (
            !('requestStatus' in incoming()) ||
            incoming().requestStatus == null ||
            incoming().requestStatus == 'pending' ||
            (
              incoming().requestStatus == 'approved' &&
              hasVerifiedEmail() &&
              exists(/databases/$(database)/documents/admins/$(authEmailLower()))
            )
          ) &&
          (
            incoming().get('assignedCardIds', []) == [] ||
            (
              hasVerifiedEmail() &&
              exists(/databases/$(database)/documents/admins/$(authEmailLower())) &&
              incoming().get('assignedCardIds', []) == get(/databases/$(database)/documents/admins/$(authEmailLower())).data.get('assignedCardIds', [])
            )
          ) &&
          (
            incoming().get('role', 'member') == 'member' ||
            (
              hasVerifiedEmail() &&
              exists(/databases/$(database)/documents/admins/$(authEmailLower())) &&
              incoming().get('role', 'member') == get(/databases/$(database)/documents/admins/$(authEmailLower())).data.role
            )
          )
        )
      );
      allow update: if isValidId(userId) && isAuthenticated() && isValidUser(incoming()) && (
        isMasterAdmin() ||
        (
          request.auth.uid == userId &&
          (
            incoming().get('accessRevoked', false) == existing().get('accessRevoked', false) ||
            (incoming().get('accessRevoked', false) == false && hasMasterReauthorizedEmail())
          ) &&
          incoming().get('requestReviewedBy', '') == existing().get('requestReviewedBy', '') &&
          (
            incoming().get('assignedCardIds', []) == existing().get('assignedCardIds', []) ||
            (
              isNotRevoked() &&
              hasVerifiedEmail() &&
              exists(/databases/$(database)/documents/admins/$(authEmailLower())) &&
              incoming().get('assignedCardIds', []) == get(/databases/$(database)/documents/admins/$(authEmailLower())).data.get('assignedCardIds', [])
            )
          ) &&
          (
            !('requestStatus' in incoming()) ||
            incoming().get('requestStatus', '') == existing().get('requestStatus', '') ||
            (isNotRevoked() && incoming().requestStatus == 'pending') ||
            (
              isNotRevoked() &&
              incoming().requestStatus == 'approved' &&
              hasVerifiedEmail() &&
              exists(/databases/$(database)/documents/admins/$(authEmailLower()))
            )
          ) &&
          (
            incoming().get('role', 'member') == existing().get('role', 'member') ||
            (
              isNotRevoked() &&
              hasVerifiedEmail() &&
              exists(/databases/$(database)/documents/admins/$(authEmailLower())) &&
              incoming().get('role', 'member') == get(/databases/$(database)/documents/admins/$(authEmailLower())).data.get('role', 'member')
            )
          )
        )
      );
      allow delete: if isValidId(userId) && isMasterAdmin() &&
        !(resource != null && 'email' in resource.data && resource.data.email is string && resource.data.email.lower() == '66shashwatkumar66@gmail.com');
    }

    // Advertisements Collection (Discreet Sponsored Ads)
    match /ads/{adId} {
      allow get, list: if true;
      allow create, update: if isValidId(adId) && isMasterAdmin() && isValidAd(incoming());
      allow delete: if isValidId(adId) && isMasterAdmin();
    }

    // QR Scan Logs Collection (Audit trail of customer QR and NFC stand interactions)
    match /qr_logs/{logId} {
      allow get: if isMasterAdmin() || (isAuthenticated() && isNotRevoked() && isSubAdminAssignedCard(resource.data.cardId));
      allow list: if isMasterAdmin() || (isAuthenticated() && isNotRevoked() && isSubAdminAssignedCard(resource.data.cardId));
      allow create: if isValidId(logId) && isValidScanLog(incoming());
      allow update, delete: if isMasterAdmin();
    }
  }
}
