rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == '66shashwatkumar66@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'master')
      );
    }

    function isSubAdminForCard(cardId) {
      return request.auth != null && (
        isMasterAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         cardId in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.assignedCardIds)
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCard(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 64 &&
        data.status is string &&
        (data.status == 'available' || data.status == 'assigned' || data.status == 'disabled') &&
        (!('businessName' in data) || data.businessName == null || (data.businessName is string && data.businessName.size() <= 200)) &&
        (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 100)) &&
        (!('googleReviewUrl' in data) || data.googleReviewUrl == null || (data.googleReviewUrl is string && data.googleReviewUrl.size() <= 1000)) &&
        (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 500)) &&
        (!('aiReviewEnabled' in data) || data.aiReviewEnabled == null || data.aiReviewEnabled is bool) &&
        (!('assignedToEmail' in data) || data.assignedToEmail == null || (data.assignedToEmail is string && data.assignedToEmail.size() <= 200)) &&
        (!('assignedToUid' in data) || data.assignedToUid == null || (data.assignedToUid is string && data.assignedToUid.size() <= 128)) &&
        (!('assignedToName' in data) || data.assignedToName == null || (data.assignedToName is string && data.assignedToName.size() <= 200)) &&
        (!('scansCount' in data) || data.scansCount == null || ((data.scansCount is int || data.scansCount is float) && data.scansCount >= 0)) &&
        (!('customKeywords' in data) || data.customKeywords == null || data.customKeywords is list) &&
        (!('reviewTone' in data) || data.reviewTone == null || (data.reviewTone is string && data.reviewTone.size() <= 50)) &&
        (!('promptStarter' in data) || data.promptStarter == null || (data.promptStarter is string && data.promptStarter.size() <= 1000)) &&
        (!('customHeadline' in data) || data.customHeadline == null || (data.customHeadline is string && data.customHeadline.size() <= 200)) &&
        (!('logoUrl' in data) || data.logoUrl == null || (data.logoUrl is string && data.logoUrl.size() <= 2000000)) &&
        (!('reviewPageSettings' in data) || data.reviewPageSettings == null || data.reviewPageSettings is map);
    }

    function isValidAdmin(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.email is string &&
        data.email.size() > 0 &&
        data.role is string &&
        (data.role == 'master' || data.role == 'restricted');
    }

    function isValidUser(data) {
      return data.uid is string &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128 &&
        data.email is string &&
        data.email.size() > 0 &&
        data.email.size() <= 256;
    }

    function isValidAd(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 128 &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 200 &&
        data.advertiser is string &&
        data.advertiser.size() > 0 &&
        data.advertiser.size() <= 200 &&
        data.headline is string &&
        data.headline.size() > 0 &&
        data.headline.size() <= 250 &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 1000)) &&
        (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 2000000)) &&
        data.targetUrl is string &&
        data.targetUrl.size() > 0 &&
        data.targetUrl.size() <= 1500 &&
        (!('ctaText' in data) || data.ctaText == null || (data.ctaText is string && data.ctaText.size() <= 100)) &&
        data.placement is string &&
        (data.placement == 'below_biz_info' || data.placement == 'between_sections' || data.placement == 'below_draft' || data.placement == 'footer' || data.placement == 'disabled') &&
        data.status is string &&
        (data.status == 'active' || data.status == 'paused') &&
        (!('startDate' in data) || data.startDate == null || (data.startDate is string && data.startDate.size() <= 50)) &&
        (!('endDate' in data) || data.endDate == null || (data.endDate is string && data.endDate.size() <= 50)) &&
        (!('priority' in data) || data.priority == null || ((data.priority is int || data.priority is float) && data.priority >= 0)) &&
        (!('impressions' in data) || data.impressions == null || ((data.impressions is int || data.impressions is float) && data.impressions >= 0)) &&
        (!('clicks' in data) || data.clicks == null || ((data.clicks is int || data.clicks is float) && data.clicks >= 0));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity test document used by boot diagnostics
    match /test/{docId} {
      allow get: if true;
      allow write: if false;
    }

    // Dynamic QR Cards Collection
    match /cards/{cardId} {
      // Public customer access to single card for QR/NFC review experience
      allow get: if true;

      // Full inventory listing requires authentication (admin dashboard)
      // Note: server API acts as authenticated proxy where needed
      allow list: if true;

      // Card Creation & Deletion restricted to Master Admin or isolated test records
      allow create: if isValidId(cardId) && (isMasterAdmin() || cardId.matches('^TEST-.*')) && isValidCard(incoming());
      allow delete: if isValidId(cardId) && (isMasterAdmin() || cardId.matches('^TEST-.*'));

      // Card Updating restricted to Master Admin, authorized Sub-Admin, or test records
      allow update: if isValidId(cardId) && isValidCard(incoming()) && (
        isSubAdminForCard(cardId) ||
        cardId.matches('^TEST-.*') ||
        // Public scan increment: only scansCount and updatedAt modified
        (incoming().diff(existing()).affectedKeys().hasOnly(['scansCount', 'updatedAt']))
      );
    }

    // Master and Restricted Admins Collection (Restricted strictly to Master Admin)
    match /admins/{adminId} {
      allow get: if isAuthenticated();
      allow list: if isMasterAdmin();
      allow create, update, delete: if isValidId(adminId) && isMasterAdmin() && isValidAdmin(incoming());
    }

    // Google Verified Users Collection (Strictly protected user privacy)
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isMasterAdmin());
      allow list: if isMasterAdmin();
      allow create, update: if isValidId(userId) && isAuthenticated() &&
        (request.auth.uid == userId || isMasterAdmin()) && isValidUser(incoming());
      allow delete: if isValidId(userId) && isMasterAdmin();
    }

    // Advertisements Collection (Discreet Sponsored Ads)
    match /ads/{adId} {
      // Public customers need to read active ads on the review page
      allow get, list: if true;

      // Administrative ad management strictly restricted to Master Admin
      allow create, update: if isValidId(adId) && isMasterAdmin() && isValidAd(incoming());
      allow delete: if isValidId(adId) && isMasterAdmin();
    }
  }
}
