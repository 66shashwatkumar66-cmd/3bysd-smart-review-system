rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCard(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.id.size() <= 64 &&
        data.status is string &&
        (data.status == 'available' || data.status == 'assigned' || data.status == 'disabled') &&
        (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 200)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('googleReviewUrl' in data) || (data.googleReviewUrl is string && data.googleReviewUrl.size() <= 1000)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('aiReviewEnabled' in data) || data.aiReviewEnabled is bool) &&
        (!('assignedToEmail' in data) || (data.assignedToEmail is string && data.assignedToEmail.size() <= 200)) &&
        (!('assignedToUid' in data) || (data.assignedToUid is string && data.assignedToUid.size() <= 128)) &&
        (!('assignedToName' in data) || (data.assignedToName is string && data.assignedToName.size() <= 200)) &&
        (!('scansCount' in data) || (data.scansCount is int && data.scansCount >= 0)) &&
        (!('customKeywords' in data) || data.customKeywords is list) &&
        (!('reviewPageSettings' in data) || data.reviewPageSettings is map);
    }

    function isValidAdmin(data) {
      return data.id is string &&
        data.id.size() > 0 &&
        data.email is string &&
        data.email.size() > 0 &&
        data.role is string &&
        (data.role == 'master' || data.role == 'restricted');
    }

    function isValidUser(data) {
      return data.uid is string &&
        data.uid.size() > 0 &&
        data.uid.size() <= 128 &&
        data.email is string &&
        data.email.size() > 0 &&
        data.email.size() <= 256;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Dynamic QR Cards Collection
    match /cards/{cardId} {
      allow get, list: if true;

      allow create: if isValidId(cardId) &&
        isValidCard(incoming());

      allow update: if isValidId(cardId) &&
        isValidCard(incoming());

      allow delete: if isValidId(cardId);
    }

    // Master and Restricted Admins Collection
    match /admins/{adminId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(adminId) && isValidAdmin(incoming());
    }

    // Google Verified Users Collection
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }
  }
}
