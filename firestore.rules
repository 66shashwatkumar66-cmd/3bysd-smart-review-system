rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isMasterAdmin() {
      return hasVerifiedEmail()
        && request.auth.token.email.lower() == '66shashwatkumar66@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9._-]+$');
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] == null || data[field] is bool;
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || data[field] == null || data[field] is number;
    }

    function isOptionalList(data, field, maxSize) {
      return !(field in data) || data[field] == null || (data[field] is list && data[field].size() <= maxSize);
    }

    // Query-planner-safe ownership check (no .lower() transform on stored field)
    function isCardOwner(data) {
      return isSignedIn() && (
        data.assignedToUid == request.auth.uid
        || (hasVerifiedEmail() && (
          data.assignedToEmail == request.auth.token.email
          || data.assignedToEmail == request.auth.token.email.lower()
        ))
      );
    }

    // =========================================================================
    // Schema Validators
    // =========================================================================

    function isValidCardFields(data, cardId) {
      return data.keys().hasOnly([
          'id', 'status', 'businessName', 'category', 'businessDescription', 'googleReviewUrl', 'notes',
          'scansCount', 'lastScannedAt', 'aiReviewEnabled', 'customKeywords',
          'reviewTone', 'promptStarter', 'customHeadline', 'logoUrl',
          'whatsapp', 'instagram', 'subscriptionStartDate', 'subscriptionEndDate',
          'subscriptionStatus', 'assignedToUid', 'assignedToEmail', 'assignedToName',
          'createdAt', 'updatedAt'
        ])
        && data.id == cardId
        && data.status in ['available', 'assigned', 'disabled']
        && isOptionalString(data, 'businessName', 250)
        && isOptionalString(data, 'category', 250)
        && isOptionalString(data, 'businessDescription', 1000)
        && isOptionalString(data, 'googleReviewUrl', 1000)
        && isOptionalString(data, 'notes', 1000)
        && isOptionalNumber(data, 'scansCount')
        && (!('scansCount' in data) || data.scansCount == null || data.scansCount >= 0)
        && isOptionalString(data, 'lastScannedAt', 64)
        && isOptionalBool(data, 'aiReviewEnabled')
        && isOptionalList(data, 'customKeywords', 50)
        && (!('reviewTone' in data) || data.reviewTone == null || data.reviewTone == '' || data.reviewTone in ['enthusiastic', 'friendly', 'professional', 'concise'])
        && isOptionalString(data, 'promptStarter', 1000)
        && isOptionalString(data, 'customHeadline', 250)
        && isOptionalString(data, 'logoUrl', 900000)
        && isOptionalString(data, 'whatsapp', 200)
        && isOptionalString(data, 'instagram', 200)
        && isOptionalString(data, 'subscriptionStartDate', 32)
        && isOptionalString(data, 'subscriptionEndDate', 32)
        && (!('subscriptionStatus' in data) || data.subscriptionStatus == null || data.subscriptionStatus == '' || data.subscriptionStatus in ['active', 'upcoming', 'expired', 'unconfigured'])
        && isOptionalString(data, 'assignedToUid', 128)
        && isOptionalString(data, 'assignedToEmail', 200)
        && isOptionalString(data, 'assignedToName', 200)
        && isOptionalString(data, 'createdAt', 64)
        && isOptionalString(data, 'updatedAt', 64);
    }

    function isSubAdminCardUpdate(cardId) {
      let changed = incoming().diff(existing()).affectedKeys();
      return isCardOwner(existing())
        && isValidCardFields(incoming(), cardId)
        && changed.hasOnly([
          'businessName', 'category', 'businessDescription', 'googleReviewUrl', 'notes',
          'aiReviewEnabled', 'customKeywords', 'reviewTone', 'promptStarter',
          'customHeadline', 'logoUrl', 'whatsapp', 'instagram',
          'status', 'updatedAt'
        ])
        && incoming().status in ['available', 'assigned']
        && incoming().id == existing().id;
    }

    function isPublicScanIncrement(cardId) {
      let changed = incoming().diff(existing()).affectedKeys();
      let prevScans = ('scansCount' in existing() && existing().scansCount is number) ? existing().scansCount : 0;
      return isValidId(cardId)
        && changed.hasOnly(['scansCount', 'updatedAt', 'lastScannedAt'])
        && changed.hasAny(['scansCount'])
        && incoming().scansCount is number
        && incoming().scansCount == prevScans + 1
        && isOptionalString(incoming(), 'updatedAt', 64)
        && isOptionalString(incoming(), 'lastScannedAt', 64);
    }

    function isValidScanLogCreate(logId) {
      let data = incoming();
      let cardPath = /databases/$(database)/documents/cards/$(data.cardId);
      let cardData = get(cardPath).data;
      let expectedEmail = ('assignedToEmail' in cardData && cardData.assignedToEmail is string) ? cardData.assignedToEmail.lower() : '';
      let expectedUid = ('assignedToUid' in cardData && cardData.assignedToUid is string) ? cardData.assignedToUid : '';
      return isValidId(logId)
        && data.keys().hasOnly([
          'id', 'cardId', 'businessName', 'category',
          'assignedToEmail', 'assignedToUid',
          'source', 'outcome', 'subscriptionStatus',
          'route', 'userAgent', 'scannedAt'
        ])
        && data.keys().hasAll(['id', 'cardId', 'source', 'outcome', 'scannedAt', 'assignedToEmail', 'assignedToUid'])
        && data.id == logId
        && isValidId(data.cardId)
        && exists(cardPath)
        && data.assignedToEmail is string
        && data.assignedToEmail == expectedEmail
        && data.assignedToUid is string
        && data.assignedToUid == expectedUid
        && data.source in ['qr', 'nfc', 'direct']
        && data.outcome in ['allowed', 'expired', 'upcoming', 'disabled', 'unassigned']
        && (!('subscriptionStatus' in data) || data.subscriptionStatus in ['active', 'upcoming', 'expired', 'unconfigured'])
        && isOptionalString(data, 'businessName', 250)
        && isOptionalString(data, 'category', 250)
        && isOptionalString(data, 'route', 300)
        && isOptionalString(data, 'userAgent', 300)
        && data.scannedAt is string && data.scannedAt.size() >= 10 && data.scannedAt.size() <= 64;
    }

    function isValidAdminData(data, adminId) {
      return isValidId(adminId)
        && data.keys().hasOnly(['id', 'email', 'name', 'role', 'assignedCardIds', 'permissions', 'createdAt', 'updatedAt'])
        && data.id == adminId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.role in ['master', 'restricted']
        && isOptionalList(data, 'assignedCardIds', 500)
        && (!('permissions' in data) || data.permissions is map)
        && isOptionalString(data, 'createdAt', 64)
        && isOptionalString(data, 'updatedAt', 64);
    }

    function isValidUserData(data, userId) {
      return isValidId(userId)
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'provider', 'role',
          'emailVerified', 'lastLoginAt', 'createdAt', 'loginCount',
          'device', 'assignedCardIds'
        ])
        && data.uid == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 200
        && data.role in ['master', 'restricted', 'member']
        && isOptionalString(data, 'photoURL', 1000)
        && isOptionalString(data, 'provider', 64)
        && isOptionalBool(data, 'emailVerified')
        && isOptionalString(data, 'lastLoginAt', 64)
        && isOptionalString(data, 'createdAt', 64)
        && isOptionalNumber(data, 'loginCount')
        && isOptionalString(data, 'device', 200)
        && isOptionalList(data, 'assignedCardIds', 500);
    }

    function isValidAdData(data, adId) {
      return isValidId(adId)
        && data.keys().hasOnly([
          'id', 'name', 'advertiser', 'headline', 'description', 'imageUrl',
          'targetUrl', 'ctaText', 'placement', 'status', 'priority',
          'impressions', 'clicks', 'startDate', 'endDate', 'createdAt', 'updatedAt'
        ])
        && data.id == adId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.headline is string && data.headline.size() >= 1 && data.headline.size() <= 300
        && data.targetUrl is string && data.targetUrl.size() >= 1 && data.targetUrl.size() <= 1000
        && data.placement in ['below_biz_info', 'between_sections', 'below_draft', 'footer', 'disabled', 'top_banner', 'below_tags']
        && data.status in ['active', 'paused']
        && isOptionalString(data, 'advertiser', 200)
        && isOptionalString(data, 'description', 1000)
        && isOptionalString(data, 'imageUrl', 900000)
        && isOptionalString(data, 'ctaText', 100)
        && isOptionalNumber(data, 'priority')
        && isOptionalNumber(data, 'impressions')
        && isOptionalNumber(data, 'clicks')
        && isOptionalString(data, 'startDate', 64)
        && isOptionalString(data, 'endDate', 64)
        && isOptionalString(data, 'createdAt', 64)
        && isOptionalString(data, 'updatedAt', 64);
    }

    function isPublicAdMetricIncrement() {
      let changed = incoming().diff(existing()).affectedKeys();
      let prevImp = ('impressions' in existing() && existing().impressions is number) ? existing().impressions : 0;
      let prevClicks = ('clicks' in existing() && existing().clicks is number) ? existing().clicks : 0;
      return (
        (changed.hasOnly(['impressions']) && incoming().impressions is number && incoming().impressions == prevImp + 1)
        || (changed.hasOnly(['clicks']) && incoming().clicks is number && incoming().clicks == prevClicks + 1)
      );
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, create, update, delete: if false;
    }

    match /cards/{cardId} {
      allow get: if isValidId(cardId);
      allow list: if isMasterAdmin() || isCardOwner(resource.data);
      allow create: if isMasterAdmin() && isValidId(cardId) && isValidCardFields(incoming(), cardId);
      allow update: if (isMasterAdmin() && isValidCardFields(incoming(), cardId))
                    || isSubAdminCardUpdate(cardId)
                    || isPublicScanIncrement(cardId);
      allow delete: if isMasterAdmin();
    }

    match /scan_logs/{logId} {
      allow get: if isMasterAdmin() || isCardOwner(resource.data);
      allow list: if isMasterAdmin() || isCardOwner(resource.data);
      allow create: if isValidScanLogCreate(logId);
      allow update, delete: if false;
    }

    match /admins/{adminId} {
      allow get: if isMasterAdmin()
                 || (hasVerifiedEmail() && (resource.data.email == request.auth.token.email || resource.data.email == request.auth.token.email.lower()));
      allow list: if isMasterAdmin()
                  || (hasVerifiedEmail() && (resource.data.email == request.auth.token.email || resource.data.email == request.auth.token.email.lower()));
      allow create: if isMasterAdmin() && isValidAdminData(incoming(), adminId);
      allow update: if isMasterAdmin() && isValidAdminData(incoming(), adminId);
      allow delete: if isMasterAdmin();
    }

    match /users/{userId} {
      allow get: if isMasterAdmin() || isOwner(userId);
      allow list: if isMasterAdmin();
      allow create: if isValidUserData(incoming(), userId) && (
        isMasterAdmin()
        || (isOwner(userId) && incoming().role == 'member' && hasVerifiedEmail() && incoming().email.lower() == request.auth.token.email.lower())
      );
      allow update: if isValidUserData(incoming(), userId) && (
        isMasterAdmin()
        || (isOwner(userId) && incoming().role == existing().role && incoming().email == existing().email && incoming().uid == existing().uid)
      );
      allow delete: if isMasterAdmin();
    }

    match /ads/{adId} {
      allow get, list: if true;
      allow create: if isMasterAdmin() && isValidAdData(incoming(), adId);
      allow update: if (isMasterAdmin() && isValidAdData(incoming(), adId)) || isPublicAdMetricIncrement();
      allow delete: if isMasterAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
