{
  "entities": {
    "Card": {
      "title": "Card",
      "description": "Dynamic QR & NFC stand card configuration mapped to a local business and optional subscription window",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique card ID (e.g. 0001)" },
        "status": { "type": "string", "enum": ["available", "assigned", "disabled"] },
        "businessName": { "type": "string" },
        "category": { "type": "string" },
        "businessDescription": { "type": "string" },
        "googleReviewUrl": { "type": "string" },
        "notes": { "type": "string" },
        "scansCount": { "type": "number" },
        "lastScannedAt": { "type": "string", "format": "date-time" },
        "aiReviewEnabled": { "type": "boolean" },
        "customKeywords": { "type": "array", "items": { "type": "string" } },
        "reviewTone": { "type": "string", "enum": ["enthusiastic", "friendly", "professional", "concise"] },
        "promptStarter": { "type": "string" },
        "customHeadline": { "type": "string" },
        "logoUrl": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "subscriptionStartDate": { "type": "string" },
        "subscriptionEndDate": { "type": "string" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "upcoming", "expired", "unconfigured"] },
        "assignedToUid": { "type": "string" },
        "assignedToEmail": { "type": "string" },
        "assignedToName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "status", "createdAt", "updatedAt"]
    },
    "ScanLog": {
      "title": "ScanLog",
      "description": "Immutable historical QR and NFC scan event log associated with a specific card and business",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cardId": { "type": "string" },
        "businessName": { "type": "string" },
        "category": { "type": "string" },
        "assignedToEmail": { "type": "string" },
        "assignedToUid": { "type": "string" },
        "source": { "type": "string", "enum": ["qr", "nfc", "direct"] },
        "outcome": { "type": "string", "enum": ["allowed", "expired", "upcoming", "disabled", "unassigned"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "upcoming", "expired", "unconfigured"] },
        "route": { "type": "string" },
        "userAgent": { "type": "string" },
        "scannedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "cardId", "source", "outcome", "scannedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "System administrator or sub-admin role profile with assigned cards and permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["master", "restricted"] },
        "assignedCardIds": { "type": "array", "items": { "type": "string" } },
        "permissions": {
          "type": "object",
          "properties": {
            "canEditCards": { "type": "boolean" },
            "canToggleAi": { "type": "boolean" },
            "canExportCsv": { "type": "boolean" },
            "canCreateCards": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "name", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Google authenticated user record and session metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "provider": { "type": "string" },
        "role": { "type": "string", "enum": ["master", "restricted", "member"] },
        "emailVerified": { "type": "boolean" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "loginCount": { "type": "number" },
        "device": { "type": "string" },
        "assignedCardIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "Sponsor advertisement displayed on customer review pages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "advertiser": { "type": "string" },
        "headline": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "targetUrl": { "type": "string" },
        "ctaText": { "type": "string" },
        "placement": { "type": "string", "enum": ["top_banner", "below_tags", "below_draft", "footer"] },
        "status": { "type": "string", "enum": ["active", "paused"] },
        "priority": { "type": "number" },
        "impressions": { "type": "number" },
        "clicks": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "headline", "targetUrl", "placement", "status"]
    }
  },
  "firestore": {
    "/cards/{cardId}": {
      "schema": { "$ref": "#/entities/Card" },
      "description": "Dynamic QR & NFC stand cards collection"
    },
    "/scan_logs/{logId}": {
      "schema": { "$ref": "#/entities/ScanLog" },
      "description": "Immutable historical QR/NFC scan event logs"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Master and restricted sub-admin profiles"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Google authenticated user accounts and login metadata"
    },
    "/ads/{adId}": {
      "schema": { "$ref": "#/entities/Advertisement" },
      "description": "Sponsor advertisements for customer review pages"
    }
  }
}
