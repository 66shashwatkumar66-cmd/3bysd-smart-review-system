{
  "entities": {
    "Card": {
      "title": "Card",
      "description": "Represents an NFC and Dynamic QR Review Card",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Card unique identifier, e.g. 0001"
        },
        "status": {
          "type": "string",
          "enum": ["available", "assigned", "disabled"],
          "description": "Deployment status of the card"
        },
        "businessName": {
          "type": "string",
          "maxLength": 200,
          "description": "Assigned business name"
        },
        "category": {
          "type": "string",
          "maxLength": 100,
          "description": "Business cuisine or category"
        },
        "googleReviewUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Destination Google Review URL"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Physical stand location notes"
        },
        "aiReviewEnabled": {
          "type": "boolean",
          "description": "Whether AI review draft assistant is enabled (true) or direct redirect (false)"
        },
        "assignedToEmail": {
          "type": "string",
          "maxLength": 200,
          "description": "Email address of the merchant user this card is assigned to"
        },
        "assignedToUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of the merchant user"
        },
        "assignedToName": {
          "type": "string",
          "maxLength": 200,
          "description": "Display name of the merchant user"
        },
        "scansCount": {
          "type": "integer",
          "description": "Total customer scans"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Card creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Card last updated timestamp"
        }
      },
      "required": ["id", "status"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "System admin profile with role-based card assignment permissions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Admin UID or email identifier"
        },
        "email": {
          "type": "string",
          "maxLength": 256,
          "description": "Admin user email address"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the admin"
        },
        "role": {
          "type": "string",
          "enum": ["master", "restricted"],
          "description": "Master admin with full powers or restricted admin for specific cards"
        },
        "assignedCardIds": {
          "type": "string",
          "description": "Comma-separated or list of card IDs this admin is authorized to edit"
        },
        "canEditCards": {
          "type": "boolean",
          "description": "Whether admin is permitted to edit assigned cards"
        },
        "canToggleAi": {
          "type": "boolean",
          "description": "Whether admin can toggle AI review feature"
        },
        "canExportCsv": {
          "type": "boolean",
          "description": "Whether admin can export CSV"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Admin registration timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Admin last updated timestamp"
        }
      },
      "required": ["id", "email", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile storing Google verified authentication details and metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique user ID"
        },
        "email": {
          "type": "string",
          "maxLength": 256,
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "User profile image URL"
        },
        "provider": {
          "type": "string",
          "maxLength": 64,
          "description": "Authentication provider e.g. google.com"
        },
        "role": {
          "type": "string",
          "enum": ["master", "restricted", "member"],
          "description": "User role"
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether user email is verified"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the most recent login"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "User account creation timestamp"
        },
        "loginCount": {
          "type": "integer",
          "description": "Number of times user logged in"
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/cards/{cardId}": {
      "schema": "Card",
      "description": "Collection of all dynamic QR cards"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Collection of master and restricted administrators"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of all users and their Google verified login data"
    }
  }
}
